# Drupal backup configuration - one file per site.
#
# Install as /etc/drupal-backup/<site>.conf, readable by root only
# (it contains the S3 credentials):
#   sudo install -d -m 700 /etc/drupal-backup
#   sudo install -m 600 backup.conf.example /etc/drupal-backup/example.conf
# Then select it with "-s example" (or "-c /path/to/file.conf"); when only one
# file exists in /etc/drupal-backup, it is used by default.

# --- Drupal site -------------------------------------------------------------
# Short name, used for the default backup directory and S3 prefix.
SITE_NAME="example"
# Composer project root (directory containing composer.json and vendor/).
SITE_ROOT="/var/www/example"
# Drupal docroot relative to SITE_ROOT ("web", "docroot", "."). Default: "web"
# if SITE_ROOT/web/index.php exists, otherwise SITE_ROOT itself.
#DOCROOT="web"
# Drush binary. Default: $SITE_ROOT/vendor/bin/drush
#DRUSH="/var/www/example/vendor/bin/drush"
# User running drush when the scripts run as root. Default: owner of SITE_ROOT.
#SITE_USER="www-data"

# Paths (relative to SITE_ROOT, tar --exclude syntax) left out of the files
# archive. Temporary files and CSS/JS aggregates are regenerated by Drupal.
# Adapt to your layout (e.g. "./web/sites/default/files/css/*").
EXCLUDES=(
  "./tmp/*"
  "./sites/default/files/css/*"
  "./sites/default/files/js/*"
  "./sites/default/files/php/*"
  "./web/sites/default/files/css/*"
  "./web/sites/default/files/js/*"
  "./web/sites/default/files/php/*"
)

# --- Local backups -----------------------------------------------------------
BACKUP_DIR="/var/backups/drupal/$SITE_NAME"
# Days to keep local backups (0 = never delete).
LOCAL_RETENTION_DAYS=7
# Log file. Default: $BACKUP_DIR/backup.log ; empty = standard output only.
#LOG_FILE=""

# --- Restore -----------------------------------------------------------------
# Owner (user:group) applied to the restored tree when running as root, e.g.
# when user IDs differ on a new server. Empty = keep ownership from the archive.
#RESTORE_OWNER="www-data:www-data"

# --- Clone target (clone.sh) -------------------------------------------------
# Only in the configuration of a clone (e.g. staging.example.conf), used with
# "clone.sh -s example -t staging.example". SITE_ROOT and BACKUP_DIR above
# must differ from the source ones.
# Host name of the clone (trusted_host_patterns). Required by clone.sh.
#CLONE_HOST="staging.example.com"
# Database and user, created by clone.sh with a new password.
# Default: SITE_NAME with "_" instead of other characters (user: 32 chars max).
#CLONE_DB_NAME="staging_example"
#CLONE_DB_USER="staging_example"
# Database host written in the settings, and host part of the database user.
#CLONE_DB_HOST="localhost"
#CLONE_DB_GRANT_HOST="localhost"
# Client used to create the database and the user. Default: mysql as root
# (unix socket authentication on Debian/Ubuntu).
#CLONE_MYSQL=(mysql --defaults-extra-file=/root/.my.cnf)
# Staging safeguards: no e-mail sent, robots.txt disallows everything,
# modules below uninstalled. 0 = plain copy under a new name.
#CLONE_STAGING=1
#CLONE_UNINSTALL_MODULES=(google_analytics)
# 1 = this site already exists (e.g. production, target of
# "clone.sh -s staging.example -t example"): it keeps its settings*.php,
# services.yml, robots.txt, database and database user, only its files and
# tables are replaced; it is backed up first. CLONE_HOST, CLONE_DB_* and
# CLONE_STAGING are then ignored. CLONE_MYSQL is still used for the import.
#CLONE_KEEP_SETTINGS=0

# --- S3-compatible object storage --------------------------------------------
# rclone provider: Other (Hetzner, generic), AWS, Cloudflare, Wasabi, Minio, Scaleway, ...
S3_PROVIDER="Other"
# Examples:
#   Hetzner : https://fsn1.your-objectstorage.com  (regions fsn1, nbg1, hel1)
#   R2      : https://<account_id>.r2.cloudflarestorage.com  (S3_PROVIDER="Cloudflare", S3_REGION="auto")
#             EU jurisdiction bucket: https://<account_id>.eu.r2.cloudflarestorage.com
#   Wasabi  : https://s3.eu-central-1.wasabisys.com
#   AWS     : leave S3_ENDPOINT empty, set S3_PROVIDER="AWS" and S3_REGION
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_BUCKET="my-bucket"
# Folder inside the bucket. Default: drupal/$SITE_NAME
#S3_PREFIX="drupal/$SITE_NAME"
S3_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXX"
S3_SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Days to keep backups on S3 (0 = never delete).
S3_RETENTION_DAYS=30
